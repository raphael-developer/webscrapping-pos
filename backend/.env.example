# ===========================================
# Configuração do Ambiente - Web Scraping API
# ===========================================
# Copie este arquivo para .env e ajuste os valores

# ----- Ambiente -----
NODE_ENV=development
# NODE_ENV=production

# ----- Servidor -----
PORT=3000
HOST=0.0.0.0

# ----- CORS (produção) -----
# Lista de origens permitidas separadas por vírgula
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ----- Arquivos de Dados -----
# Caminho customizado para o arquivo de cursos (opcional)
# COURSES_DATA_FILE=/path/to/cursos.json

# ----- Target URL -----
# URL alvo para scraping
TARGET_URL=https://www.faculdadeunica.com.br/pos-graduacao

# ----- Scraper: Timeouts (em milissegundos) -----
SCRAPER_CLUSTER_TIMEOUT=240000
SCRAPER_PAGE_TIMEOUT=180000
SCRAPER_NAV_TIMEOUT=60000
SCRAPER_TASK_TIMEOUT=300000
SCRAPER_COURSES_TASK_TIMEOUT=240000

# ----- Scraper: Concorrência -----
SCRAPER_CONCURRENCY=1
SCRAPER_RETRY_LIMIT=3
SCRAPER_RETRY_DELAY=2000
SCRAPER_CATEGORY_ATTEMPTS=2

# ----- Scraper: Load More (paginação) -----
SCRAPER_LOAD_MORE_MODE=full
SCRAPER_LOAD_MORE_LIMIT=500
SCRAPER_LOAD_MORE_MAX_MS=180000
SCRAPER_LOAD_MORE_CLICKS=50
SCRAPER_LOAD_MORE_WAIT_MS=2000
SCRAPER_STABLE_THRESHOLD=5

# ----- Scraper: Performance -----
# Bloquear recursos (imagens, mídia) para performance
SCRAPER_BLOCK_RESOURCES=1
# Bloquear trackers e analytics
SCRAPER_BLOCK_TRACKERS=1
# Forçar modo headless
SCRAPER_FORCE_HEADLESS=1
# Usar lista fixa de categorias
SCRAPER_FORCE_CATEGORIES=1

# ----- Scraper: Debug -----
# Habilitar modo debug (mostra navegador)
# SCRAPER_DEBUG=1
# Habilitar timing logs
# SCRAPER_TIMING=1
# Salvar artefatos de debug (screenshots/HTML)
# SCRAPER_SAVE_ARTIFACTS=1
SCRAPER_ARTIFACTS_DIR=logs/scraper-artifacts
SCRAPER_ARTIFACTS_MAX=10

# ----- Scraper: User Agent -----
SCRAPER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/118.0 Safari/537.36

# ----- Puppeteer -----
# Caminho para executável do Chrome/Chromium (se não usar o bundled)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# Timeout do protocolo
PUPPETEER_PROTOCOL_TIMEOUT=300000

# ----- Rate Limiting -----
# Janela de tempo em ms
RATE_LIMIT_WINDOW_MS=60000
# Máximo de requests por janela (geral)
RATE_LIMIT_MAX=100
# Máximo de scrapes por janela
RATE_LIMIT_SCRAPER_MAX=5

# ----- WooCommerce API -----
# Configuração para integração com WooCommerce REST API
WOOCOMMERCE_URL=https://unicaposead.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_TIMEOUT=30000
WOOCOMMERCE_API_VERSION=wc/v3

# ----- Logging -----
LOG_LEVEL=debug
# LOG_LEVEL=info (para produção)
LOG_MAX_FILES=30
LOG_MAX_SIZE=10m
